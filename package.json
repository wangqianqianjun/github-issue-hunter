{
  "name": "github-issue-hunter-ts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TypeScript-first GitHub Issue Hunter with UI, multi-repo scheduler, and Vercel Chat Slack bridge",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "quickstart": "bash scripts/quickstart.sh",
    "install:oneclick": "bash scripts/install.sh",
    "service:start": "bash scripts/service.sh start",
    "service:stop": "bash scripts/service.sh stop",
    "service:restart": "bash scripts/service.sh restart",
    "service:status": "bash scripts/service.sh status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.14.0",
    "@chat-adapter/state-memory": "^4.14.0",
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.12.0",
    "chat": "^4.14.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
